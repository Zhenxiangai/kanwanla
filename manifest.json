{
  "manifest_version": 3,
  "name": "看完啦",
  "version": "2.2.1",
  "minimum_chrome_version": "116",
  "description": "将 YouTube 和 B 站视频转化为带字幕、翻译、AI 概览和笔记的学习资料。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.siliconflow.cn/*",
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://api.gitcode.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "打开看完啦",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["i18n.js", "notes.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": ["i18n.js", "notes.js", "bilibili-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
